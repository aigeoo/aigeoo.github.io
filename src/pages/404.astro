---
import Layout from '../components/Layout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
---

<Layout
  title={`404 — ${t('site.name')}`}
  description="Page not found."
  canonicalPath="/404/"
  lang="en"
>
  <main class="content-shell">
    <div class="page-hero">
      <p class="eyebrow"><span class="status-dot dot-blue"></span>page not found</p>
      <h1>404</h1>
      <p class="hero-lede">
        This page doesn't exist. It may have been moved, deleted, or never published.
        <br />هذه الصفحة غير موجودة.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Go home</a>
        <a class="button button-secondary" href="/blog/">Browse the blog</a>
      </div>
    </div>
  </main>
</Layout>
